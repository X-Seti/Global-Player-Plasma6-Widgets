// X-Seti - Jun 2026 - Global Player - Plasma 6.6
// Radio (D-Bus daemon) + local files / streams (Qt Multimedia)
// Cover art in panel + expanded UI; embedded MP3 art via ffmpeg
import QtQuick
import QtQuick.Layouts
import QtQuick.Controls
import QtMultimedia
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.components 3.0 as PC3
import org.kde.plasma.plasmoid
import org.kde.plasma.plasma5support as Plasma5Support
import org.kde.kirigami 2.20 as Kirigami

PlasmoidItem {
    id: root

    property var stationsModel: []
    property int stationIndex: 0
    property string selectedStation: {
        if (stationsModel.length === 0) return ""
        if (stationIndex < 0 || stationIndex >= stationsModel.length) return ""
        return stationsModel[stationIndex]
    }
    property string nowArtist: ""
    property string nowTitle: ""
    property string nowShow: ""
    property string playState: "Stopped"
    property bool loggingEnabled: false
    property bool pushNotifications: false
    property url artworkUrl: ""
    property bool daemonConnected: false
    property string errorMessage: ""

    property bool mediaMode: false
    property bool isPlaying: mediaMode
        ? (mediaPlayer.playbackState === MediaPlayer.PlayingState)
        : (playState === "Playing")

    property int volumeValue: 80
    property int playDelayValue: 0

    property string mediaSource: ""
    property string mediaSourceDisplay: {
        if (!mediaSource || mediaSource.length === 0)
            return "No media selected"
        var s = mediaSource
        if (s.indexOf("file://") === 0) {
            s = s.substring(7)
            var parts = s.split("/")
            return parts[parts.length - 1] || s
        }
        return s
    }

    property string visualizerStyle: "2-channel Stereo"
    property string visualizerOrientation: "Horizontal"
    property int visualizerBarCount: 2

    property string displayTitle: {
        if (mediaMode) {
            if (nowArtist && nowTitle) return nowArtist + " - " + nowTitle
            if (nowTitle) return nowTitle
            return mediaSourceDisplay
        }
        if (nowArtist && nowTitle) return nowArtist + " - " + nowTitle
        if (nowTitle) return nowTitle
        if (selectedStation) return selectedStation
        if (!daemonConnected) return "Connecting..."
        if (stationsModel.length === 0) return "No Stations"
        return "Global Player"
    }

    property string nowPlaying: {
        if (mediaMode) {
            if (nowArtist && nowTitle) return nowArtist + " - " + nowTitle
            if (nowTitle) return nowTitle
            if (mediaPlayer.error !== MediaPlayer.NoError)
                return "Error: " + mediaPlayer.errorString
            if (isPlaying) return "Playing media..."
            if (mediaSource.length > 0) return "Ready - press Play"
            return "Enter a file path or stream URL"
        }
        if (nowArtist && nowTitle) return nowArtist + " - " + nowTitle
        if (nowTitle) return nowTitle
        if (!daemonConnected) return "Waiting for daemon..."
        if (stationsModel.length === 0) return "No stations loaded"
        return "Select a station"
    }

    property var playedSongs: []

    toolTipSubText: {
        if (mediaMode) {
            if (isPlaying) return "Media: " + mediaSourceDisplay
            return "Media mode - " + (mediaSource.length ? "Ready" : "Idle")
        }
        if (!daemonConnected) return "Daemon not connected"
        if (playState === "Playing" && selectedStation)
            return "Playing: " + selectedStation
        return playState
    }

    ListModel { id: playedSongsModel }

    MediaPlayer {
        id: mediaPlayer
        audioOutput: AudioOutput {
            id: mediaAudio
            volume: root.volumeValue / 100.0
        }
        onPlaybackStateChanged: {
            if (playbackState === MediaPlayer.PlayingState)
                root.playState = "Playing"
            else if (playbackState === MediaPlayer.PausedState)
                root.playState = "Paused"
            else
                root.playState = "Stopped"
        }
        onMetaDataChanged: {
            var title = ""
            var artist = ""
            try {
                if (mediaPlayer.metaData) {
                    var t = mediaPlayer.metaData.value("title")
                        || mediaPlayer.metaData.value("Title")
                    var a = mediaPlayer.metaData.value("artist")
                        || mediaPlayer.metaData.value("Artist")
                        || mediaPlayer.metaData.value("albumArtist")
                    if (t) title = "" + t
                    if (a) artist = "" + a
                }
            } catch (e) {}
            if (title) root.nowTitle = title
            if (artist) root.nowArtist = artist
            if (title || artist)
                addToHistory(title || mediaSourceDisplay, artist || "Local/Stream")
        }
        onErrorOccurred: function(error, errorString) {
            console.log("MediaPlayer error:", error, errorString)
            root.errorMessage = errorString || "Playback error"
        }
    }

    Timer {
        id: startupTimer
        interval: 1000
        running: true
        repeat: true
        property int attempts: 0
        onTriggered: {
            attempts++
            if (!daemonConnected) {
                testDaemonConnection()
                if (attempts >= 10) {
                    if (!mediaMode)
                        errorMessage = "Cannot connect to daemon. Is it running?"
                    running = false
                }
            } else {
                running = false
            }
        }
    }

    Timer {
        id: pollTimer
        interval: 10000
        running: daemonConnected && !mediaMode
        repeat: true
        onTriggered: {
            if (daemonConnected && !mediaMode)
                getNowPlaying()
        }
    }

    // Fast poll for audio levels from daemon (radio mode)
    Timer {
        id: levelsTimer
        interval: 50
        running: daemonConnected && !mediaMode && isPlaying
        repeat: true
        onTriggered: getLevels()
    }

    // Latest levels from daemon (0..1). Empty until first GetLevels reply.
    property var audioLevels: ({ "left": 0, "right": 0, "bands": [] })
    property bool hasDaemonLevels: false

    Timer {
        id: expandTimer
        interval: 300
        repeat: false
        onTriggered: {
            if (!mediaMode) {
                refreshStations()
                getState()
            }
        }
    }

    Plasma5Support.DataSource {
        id: execDS
        engine: "executable"
        onNewData: function(sourceName, data) {
            var out = (data["stdout"] || "").trim()
            var err = (data["stderr"] || "").trim()
            if (err)
                console.log("Command error:", err)

            if (sourceName.indexOf("gpd-cover") !== -1 || sourceName.indexOf("ffmpeg") !== -1) {
                if (out.indexOf("/tmp/gpd-cover-") === 0) {
                    artworkUrl = "file://" + out
                    console.log("Embedded cover set:", artworkUrl)
                } else if (sourceName.indexOf("gpd-cover") !== -1) {
                    console.log("No embedded cover found")
                }
                disconnectSource(sourceName)
                return
            }

            if (err && (err.indexOf("not find") !== -1 || err.indexOf("not available") !== -1))
                daemonConnected = false

            if (sourceName.indexOf("GetLevels") !== -1) {
                try {
                    var raw = out
                    // Strip wrapping single quotes from Python str()
                    if (raw.length >= 2 && raw.charAt(0) === "'" && raw.charAt(raw.length - 1) === "'")
                        raw = raw.substring(1, raw.length - 1)
                    // Strip wrapping double quotes if the whole payload is a JSON string
                    if (raw.length >= 2 && raw.charAt(0) === '"' && raw.charAt(raw.length - 1) === '"') {
                        try { raw = JSON.parse(raw) } catch (e1) {}
                    }
                    var lv = (typeof raw === "string") ? JSON.parse(raw) : raw
                    applyDaemonLevels(lv)
                } catch (e) {
                    // Missing method or bad payload — visualiser will decay
                }
            } else if (sourceName.indexOf("GetNowPlaying") !== -1) {
                try {
                    var m = JSON.parse(out)
                    nowArtist = m.artist || ""
                    nowTitle = m.title || ""
                    nowShow = m.show || ""
                    if (!mediaMode)
                        playState = m.state || playState
                    setArtworkFromPath(m.artworkPath || "")
                    if (m.levels)
                        applyDaemonLevels(m.levels)
                    if (!mediaMode && (nowArtist || nowTitle))
                        addToHistory(nowTitle, nowArtist)
                } catch (e) {
                    console.log("Error parsing GetNowPlaying:", e)
                }
            } else if (sourceName.indexOf("GetState") !== -1) {
                try {
                    var s = JSON.parse(out)
                    if (!mediaMode)
                        playState = s.state || playState
                    loggingEnabled = s.logging === true
                    pushNotifications = s.notifications === true
                    var st = s.station || ""
                    if (st.length > 0 && stationsModel.indexOf(st) >= 0)
                        stationIndex = stationsModel.indexOf(st)
                    daemonConnected = true
                    if (s.volume !== undefined)
                        volumeValue = s.volume
                    if (s.playDelay !== undefined)
                        playDelayValue = s.playDelay
                } catch (e) {
                    console.log("Error parsing GetState:", e)
                }
            } else if (sourceName.indexOf("GetStations") !== -1) {
                try {
                    var arr = JSON.parse(out)
                    if (arr && arr.length > 0) {
                        stationsModel = arr
                        if (stationIndex >= arr.length)
                            stationIndex = 0
                        daemonConnected = true
                        errorMessage = ""
                    } else {
                        errorMessage = "No stations available. Check daemon logs."
                    }
                } catch (e) {
                    errorMessage = "Failed to parse station list"
                }
            }
            disconnectSource(sourceName)
        }
    }

    function shellQuote(s) {
        return "'" + ("" + s).replace(/'/g, "'\\''") + "'"
    }

    function setArtworkFromPath(path) {
        if (!path || ("" + path).length === 0) {
            artworkUrl = ""
            return
        }
        var p = "" + path
        if (p.indexOf("file://") === 0)
            artworkUrl = p
        else if (p.indexOf("/") === 0)
            artworkUrl = "file://" + p
        else
            artworkUrl = "file:///" + p
        console.log("Artwork URL set to:", artworkUrl)
    }

    function extractEmbeddedCover(fileUrl) {
        var path = ("" + fileUrl).replace(/^file:\/\//, "")
        if (!path.length || path.indexOf("http") === 0) {
            artworkUrl = ""
            return
        }
        var outPath = "/tmp/gpd-cover-" + Date.now() + ".jpg"
        var cmd = "ffmpeg -y -i " + shellQuote(path)
            + " -an -vcodec copy " + shellQuote(outPath)
            + " 2>/dev/null; "
            + "if [ -s " + shellQuote(outPath) + " ]; then echo " + shellQuote(outPath)
            + "; else rm -f " + shellQuote(outPath) + "; echo ''; fi"
        execDS.connectSource(cmd)
    }

    function qdbusCall(method, args) {
        var pythonCmd = "/usr/bin/python3 -c \""
        pythonCmd += "import dbus, json, sys; "
        pythonCmd += "bus = dbus.SessionBus(); "
        pythonCmd += "obj = bus.get_object('org.mooheda.gpd', '/org/mooheda/gpd'); "
        pythonCmd += "iface = dbus.Interface(obj, 'org.mooheda.gpd1'); "
        if (args && args.length > 0) {
            var escapedArgs = []
            for (var i = 0; i < args.length; ++i) {
                var a = ("" + args[i]).replace(/'/g, "\\'")
                escapedArgs.push("'" + a + "'")
            }
            pythonCmd += "result = iface." + method + "(" + escapedArgs.join(", ") + "); "
        } else {
            pythonCmd += "result = iface." + method + "(); "
        }
        pythonCmd += "print(str(result))\""
        console.log("D-Bus call:", method)
        execDS.connectSource(pythonCmd)
    }

    function testDaemonConnection() { qdbusCall("GetState", []) }
    function getNowPlaying() {
        if (!mediaMode && daemonConnected)
            qdbusCall("GetNowPlaying", [])
    }
    function getLevels() {
        if (!mediaMode && daemonConnected)
            qdbusCall("GetLevels", [])
    }

    // Accept daemon payload and store normalised 0..1 levels
    // Supported shapes:
    //   { "left": 0.2, "right": 0.5 }
    //   { "peaks": [0.2, 0.5] }
    //   { "bands": [0.1, 0.2, ...] }   // multi-band EQ
    //   { "left": 0.2, "right": 0.5, "bands": [...] }
    function applyDaemonLevels(lv) {
        if (!lv || typeof lv !== "object")
            return
        var left = 0, right = 0
        var bands = []
        if (lv.bands && lv.bands.length)
            bands = lv.bands
        if (lv.peaks && lv.peaks.length >= 2) {
            left = Number(lv.peaks[0]) || 0
            right = Number(lv.peaks[1]) || 0
        }
        if (lv.left !== undefined) left = Number(lv.left) || 0
        if (lv.right !== undefined) right = Number(lv.right) || 0
        // Clamp
        function clamp01(x) {
            x = Number(x)
            if (isNaN(x)) return 0
            if (x < 0) return 0
            if (x > 1) return 1
            return x
        }
        left = clamp01(left)
        right = clamp01(right)
        var b2 = []
        for (var i = 0; i < bands.length; i++)
            b2.push(clamp01(bands[i]))
        audioLevels = { "left": left, "right": right, "bands": b2 }
        hasDaemonLevels = true
    }
    function getState() {
        if (daemonConnected)
            qdbusCall("GetState", [])
    }
    function refreshStations() {
        if (!mediaMode)
            qdbusCall("GetStations", [])
    }
    function signIn() {
        if (!mediaMode)
            qdbusCall("SignIn", [])
    }

    function normalizeMediaSource(raw) {
        var s = ("" + raw).trim()
        if (!s.length) return ""
        if (/^(https?|file|ftp|rtsp|rtmp|mms):\/\//i.test(s))
            return s
        if (s.indexOf("/") === 0)
            return "file://" + s
        return s
    }

    function playMediaSource(src) {
        var url = normalizeMediaSource(src || mediaSource)
        if (!url.length) {
            errorMessage = "Enter a local path or stream URL first"
            return
        }
        mediaSource = url
        errorMessage = ""
        nowArtist = ""
        nowTitle = ""
        artworkUrl = ""
        mediaPlayer.source = url
        mediaPlayer.play()
        addToHistory(mediaSourceDisplay, "Local/Stream")
        console.log("Media play:", url)
        if (url.indexOf("file://") === 0 || (url.indexOf("/") === 0 && url.indexOf("http") !== 0))
            extractEmbeddedCover(url)
    }

    function togglePlay() {
        if (mediaMode) {
            if (mediaPlayer.playbackState === MediaPlayer.PlayingState)
                mediaPlayer.pause()
            else if (mediaPlayer.playbackState === MediaPlayer.PausedState)
                mediaPlayer.play()
            else
                playMediaSource(mediaSource)
            return
        }
        if (!daemonConnected) {
            errorMessage = "Daemon not connected"
            return
        }
        if (isPlaying)
            qdbusCall("Pause", [])
        else
            playCurrent()
    }

    function playCurrent() {
        if (mediaMode) {
            playMediaSource(mediaSource)
            return
        }
        if (!daemonConnected) {
            errorMessage = "Daemon not connected"
            return
        }
        if (stationsModel.length === 0) {
            refreshStations()
            Qt.callLater(function() {
                if (stationsModel.length > 0)
                    _doPlay()
                else
                    errorMessage = "No stations available"
            })
            return
        }
        _doPlay()
    }

    function _doPlay() {
        if (stationIndex < 0 || stationIndex >= stationsModel.length)
            stationIndex = 0
        selectedStation = stationsModel[stationIndex]
        console.log("Playing station:", selectedStation)
        qdbusCall("Play", [selectedStation])
        if (!pollTimer.running)
            pollTimer.start()
        getState()
        getNowPlaying()
    }

    function stopPlayback() {
        if (mediaMode) {
            mediaPlayer.stop()
            playState = "Stopped"
            return
        }
        if (!daemonConnected) return
        qdbusCall("Pause", [])
    }

    function nextStation() {
        if (mediaMode || stationsModel.length === 0) return
        stationIndex = (stationIndex + 1) % stationsModel.length
        playCurrent()
    }

    function prevStation() {
        if (mediaMode || stationsModel.length === 0) return
        stationIndex = (stationIndex - 1 + stationsModel.length) % stationsModel.length
        playCurrent()
    }

    function switchMode() {
        if (mediaMode) {
            if (mediaPlayer.playbackState === MediaPlayer.PlayingState)
                mediaPlayer.pause()
        } else if (playState === "Playing") {
            qdbusCall("Pause", [])
        }
        mediaMode = !mediaMode
        errorMessage = ""
        nowArtist = ""
        nowTitle = ""
        artworkUrl = ""
        playState = "Stopped"
        console.log("Switched to", mediaMode ? "Media" : "Radio", "mode")
        if (!mediaMode) {
            refreshStations()
            getState()
        }
    }

    function addToHistory(song, artist) {
        var newSong = {
            "time": new Date().toLocaleTimeString(),
            "song": song || "Unknown Song",
            "artist": artist || "Unknown Artist",
            "station": mediaMode ? "Local/Stream" : selectedStation
        }
        if (playedSongs.length > 0) {
            var last = playedSongs[0]
            if (last.song === newSong.song && last.artist === newSong.artist)
                return
        }
        playedSongs.unshift(newSong)
        if (playedSongs.length > 10)
            playedSongs.pop()
        playedSongsModel.clear()
        for (var i = 0; i < playedSongs.length; i++)
            playedSongsModel.append(playedSongs[i])
    }

    function applyVisualizerStyle(name) {
        root.visualizerStyle = name
        if (name === "2-channel Stereo") {
            root.visualizerBarCount = 2
            root.visualizerOrientation = "Horizontal"
        } else if (name === "10-band EQ" || name === "Mirrored EQ") {
            root.visualizerBarCount = 10
        } else if (name === "20-band EQ") {
            root.visualizerBarCount = 20
        } else if (name === "LED Dots") {
            root.visualizerBarCount = 16
        } else if (name === "Waveform") {
            root.visualizerBarCount = 48
        } else if (name === "Circular") {
            root.visualizerBarCount = 32
        } else if (name === "Analog Meter") {
            root.visualizerBarCount = 2
        } else {
            root.visualizerBarCount = 1
        }
        vuMeter.resetLevels()
    }

    Component.onCompleted: {
        console.log("Global Player v3.6 initializing...")
        addToHistory("Starting Global Player", "System")
        mediaAudio.volume = volumeValue / 100.0
    }

    onExpandedChanged: {
        if (expanded && daemonConnected && !mediaMode)
            expandTimer.restart()
    }

    onVolumeValueChanged: {
        mediaAudio.volume = volumeValue / 100.0
    }

    // Compact panel icon
    compactRepresentation: Item {
        Layout.preferredWidth: PlasmaCore.Units.iconSizes.small
        Layout.preferredHeight: PlasmaCore.Units.iconSizes.small

        Rectangle {
            anchors.fill: parent
            anchors.margins: 1
            radius: 3
            color: Kirigami.Theme.backgroundColor
            border.color: {
                if (!mediaMode && !daemonConnected)
                    return Kirigami.Theme.negativeTextColor
                return isPlaying ? Kirigami.Theme.positiveTextColor
                                 : Kirigami.Theme.textColor
            }
            border.width: 2

            Image {
                id: compactCoverArt
                anchors.fill: parent
                anchors.margins: 3
                fillMode: Image.PreserveAspectFit
                source: root.artworkUrl
                asynchronous: true
                cache: false
                visible: status === Image.Ready && root.artworkUrl.toString() !== ""
            }

            Kirigami.Icon {
                anchors.centerIn: parent
                source: mediaMode ? "folder-music" : "radio"
                width: parent.width * 0.55
                height: parent.height * 0.55
                visible: root.artworkUrl.toString() === ""
                         || compactCoverArt.status !== Image.Ready
            }

            Rectangle {
                anchors.bottom: parent.bottom
                anchors.right: parent.right
                anchors.margins: 1
                width: 6
                height: 6
                radius: 3
                color: {
                    if (!mediaMode && !daemonConnected)
                        return Kirigami.Theme.negativeTextColor
                    return isPlaying ? Kirigami.Theme.positiveTextColor
                                     : Kirigami.Theme.neutralTextColor
                }
                opacity: 0.9
            }
        }

        MouseArea {
            anchors.fill: parent
            acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
            hoverEnabled: true
            onClicked: function(mouse) {
                if (mouse.button === Qt.LeftButton) togglePlay()
                else if (mouse.button === Qt.RightButton) nextStation()
                else if (mouse.button === Qt.MiddleButton)
                    root.expanded = !root.expanded
            }
            onPressAndHold: root.expanded = !root.expanded
            onWheel: function(wheel) {
                if (wheel.angleDelta.y > 0) prevStation()
                else nextStation()
                wheel.accepted = true
            }
            PC3.ToolTip {
                text: {
                    var t = displayTitle
                    if (errorMessage !== "") t += "\n" + errorMessage
                    if (nowShow !== "") t += "\nShow: " + nowShow
                    t += "\nMode: " + (mediaMode ? "Media" : "Radio")
                    t += "\nStatus: " + (mediaMode ? playState
                        : (daemonConnected ? playState : "Disconnected"))
                    return t
                }
                visible: parent.containsMouse && !root.expanded
                delay: 500
            }
        }
    }

    // Full panel
    fullRepresentation: ColumnLayout {
        width: PlasmaCore.Units.gridUnit * 38
        height: PlasmaCore.Units.gridUnit * 34
        Layout.preferredWidth: PlasmaCore.Units.gridUnit * 38
        Layout.preferredHeight: PlasmaCore.Units.gridUnit * 34
        spacing: PlasmaCore.Units.smallSpacing

        // Error banner
        Rectangle {
            visible: errorMessage !== "" || (!mediaMode && !daemonConnected)
            Layout.fillWidth: true
            implicitHeight: bannerRow.implicitHeight + PlasmaCore.Units.smallSpacing * 2
            color: Kirigami.Theme.negativeBackgroundColor
            radius: PlasmaCore.Units.smallSpacing
            RowLayout {
                id: bannerRow
                anchors.centerIn: parent
                width: parent.width - PlasmaCore.Units.smallSpacing * 2
                spacing: PlasmaCore.Units.smallSpacing
                Kirigami.Icon {
                    source: "dialog-warning"
                    width: PlasmaCore.Units.iconSizes.small
                    height: PlasmaCore.Units.iconSizes.small
                }
                PC3.Label {
                    Layout.fillWidth: true
                    text: errorMessage !== ""
                        ? errorMessage
                        : "Daemon not connected - use Media mode or start gpd.service"
                    color: Kirigami.Theme.negativeTextColor
                    wrapMode: Text.WordWrap
                }
                PC3.Button {
                    text: "Retry"
                    visible: !daemonConnected && !mediaMode
                    onClicked: {
                        testDaemonConnection()
                        refreshStations()
                    }
                }
            }
        }

        // Mode row
        RowLayout {
            Layout.fillWidth: true
            PC3.Label {
                text: "Mode"
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
            }
            PC3.Button {
                text: "Radio"
                icon.name: "radio"
                checkable: true
                checked: !mediaMode
                onClicked: { if (mediaMode) switchMode() }
            }
            PC3.Button {
                text: "Media / Stream"
                icon.name: "folder-music"
                checkable: true
                checked: mediaMode
                onClicked: { if (!mediaMode) switchMode() }
            }
            Item { Layout.fillWidth: true }
            Kirigami.Icon {
                source: "media-playback-start"
                width: PlasmaCore.Units.iconSizes.small
                height: PlasmaCore.Units.iconSizes.small
                visible: isPlaying
            }
            PC3.Label {
                text: isPlaying ? "Playing" : playState
                opacity: 0.7
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
            }
        }

        // Station combo (radio)
        PC3.ComboBox {
            id: stationCombo
            Layout.fillWidth: true
            model: stationsModel
            currentIndex: stationIndex
            visible: !mediaMode
            onActivated: {
                stationIndex = index
                playCurrent()
            }
        }

        // Media URL + Load
        RowLayout {
            Layout.fillWidth: true
            visible: mediaMode
            spacing: PlasmaCore.Units.smallSpacing
            PC3.TextField {
                id: mediaUrlField
                Layout.fillWidth: true
                placeholderText: "MP3 path or stream URL"
                text: mediaSource
                onAccepted: playMediaSource(text)
            }
            PC3.Button {
                text: "Load and Play"
                icon.name: "media-playback-start"
                highlighted: true
                onClicked: playMediaSource(mediaUrlField.text)
            }
            PC3.Button {
                text: "Clear"
                icon.name: "edit-clear"
                onClicked: {
                    mediaPlayer.stop()
                    mediaSource = ""
                    mediaUrlField.text = ""
                    artworkUrl = ""
                    nowTitle = ""
                    nowArtist = ""
                }
            }
        }

        // Cover art LEFT of controls
        RowLayout {
            Layout.fillWidth: true
            Layout.preferredHeight: 120
            Layout.minimumHeight: 120
            Layout.maximumHeight: 140
            spacing: 12

            // Fixed-size cover art box (left)
            Rectangle {
                id: artworkBox
                width: 120
                height: 120
                Layout.preferredWidth: 120
                Layout.preferredHeight: 120
                Layout.minimumWidth: 120
                Layout.minimumHeight: 120
                Layout.maximumWidth: 120
                Layout.maximumHeight: 120
                implicitWidth: 120
                implicitHeight: 120
                radius: 6
                color: "#2a2e32"
                border.color: isPlaying ? "#3daee9" : "#555555"
                border.width: 2

                Image {
                    id: coverArtImage
                    anchors.fill: parent
                    anchors.margins: 4
                    source: root.artworkUrl
                    fillMode: Image.PreserveAspectFit
                    asynchronous: true
                    cache: false
                    visible: status === Image.Ready && root.artworkUrl.toString() !== ""
                    onStatusChanged: {
                        if (status === Image.Error)
                            console.log("Cover art failed:", root.artworkUrl)
                        else if (status === Image.Ready)
                            console.log("Cover art loaded:", root.artworkUrl)
                    }
                }

                Kirigami.Icon {
                    anchors.centerIn: parent
                    source: mediaMode ? "folder-music" : "radio"
                    width: 48
                    height: 48
                    color: "#888888"
                    visible: root.artworkUrl.toString() === ""
                             || coverArtImage.status !== Image.Ready
                }
            }

            // Controls to the RIGHT of cover art
            ColumnLayout {
                Layout.fillWidth: true
                Layout.fillHeight: true
                spacing: 4

                PC3.Label {
                    text: mediaMode
                        ? mediaSourceDisplay
                        : (selectedStation || "No Station Selected")
                    font.bold: true
                    font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.15
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    elide: Text.ElideMiddle
                    maximumLineCount: 2
                }

                PC3.Label {
                    Layout.fillWidth: true
                    text: nowPlaying
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    maximumLineCount: 2
                    elide: Text.ElideRight
                }

                RowLayout {
                    Layout.fillWidth: true
                    Layout.alignment: Qt.AlignHCenter
                    spacing: 6
                    PC3.Button {
                        icon.name: "media-skip-backward"
                        onClicked: prevStation()
                        enabled: !mediaMode && daemonConnected && stationsModel.length > 1
                    }
                    PC3.Button {
                        icon.name: isPlaying ? "media-playback-pause" : "media-playback-start"
                        onClicked: togglePlay()
                        enabled: mediaMode
                            ? (mediaSource.length > 0 || mediaUrlField.text.length > 0)
                            : daemonConnected
                        highlighted: isPlaying
                    }
                    PC3.Button {
                        icon.name: "media-playback-stop"
                        onClicked: stopPlayback()
                        enabled: isPlaying
                            || (mediaMode && mediaPlayer.playbackState !== MediaPlayer.StoppedState)
                    }
                    PC3.Button {
                        icon.name: "media-skip-forward"
                        onClicked: nextStation()
                        enabled: !mediaMode && daemonConnected && stationsModel.length > 1
                    }
                }

                PC3.Label {
                    visible: !mediaMode && stationsModel.length > 0
                    text: "Station " + (stationIndex + 1) + " of " + stationsModel.length
                    font.pointSize: Kirigami.Theme.smallestFont.pointSize
                    opacity: 0.7
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                }

                Item { Layout.fillHeight: true }
            }
        }

        // Volume
        RowLayout {
            Layout.fillWidth: true
            spacing: 6
            Kirigami.Icon {
                source: "player-volume"
                width: PlasmaCore.Units.iconSizes.smallMedium
                height: PlasmaCore.Units.iconSizes.smallMedium
                color: Kirigami.Theme.textColor
            }
            PC3.Slider {
                id: volumeSlider
                from: 0
                to: 100
                value: root.volumeValue
                stepSize: 5
                Layout.fillWidth: true
                onMoved: {
                    root.volumeValue = value
                    if (!mediaMode && daemonConnected)
                        qdbusCall("SetVolume", [value])
                }
            }
            PC3.Label {
                text: volumeSlider.value + "%"
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
                Layout.preferredWidth: 36
            }
        }

        // Visualiser picker
        RowLayout {
            Layout.fillWidth: true
            spacing: 6
            PC3.Label {
                text: "Visualiser"
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
            }
            PC3.ComboBox {
                id: visualizerStyleCombo
                Layout.fillWidth: true
                model: [
                    "2-channel Stereo",
                    "10-band EQ",
                    "20-band EQ",
                    "Mirrored EQ",
                    "LED Dots",
                    "Waveform",
                    "Circular",
                    "Analog Meter"
                ]
                currentIndex: Math.max(0, model.indexOf(root.visualizerStyle))
                onActivated: applyVisualizerStyle(currentText)
            }
            PC3.ComboBox {
                id: visualizerOrientationCombo
                model: ["Horizontal", "Vertical"]
                currentIndex: model.indexOf(root.visualizerOrientation)
                enabled: root.visualizerStyle !== "2-channel Stereo"
                         && root.visualizerStyle !== "Analog Meter"
                         && root.visualizerStyle !== "Waveform"
                         && root.visualizerStyle !== "Circular"
                onActivated: {
                    root.visualizerOrientation = currentText
                    vuMeter.requestLayout()
                }
            }
        }

        // Visualiser strip
        Rectangle {
            id: vuMeter
            Layout.fillWidth: true
            Layout.preferredHeight: 90
            Layout.minimumHeight: 90
            Layout.maximumHeight: 90
            implicitHeight: 90
            color: "#121412"
            radius: 3
            clip: true

            property var barHeights: []
            property int barCount: root.visualizerBarCount
            property real phase: 0

            function resetLevels() {
                var values = []
                for (var i = 0; i < barCount; i++) values.push(0)
                barHeights = values
                phase = 0
                repaintAll()
            }
            function requestLayout() { repaintAll() }
            function repaintAll() {
                barCanvas.requestPaint()
                waveCanvas.requestPaint()
                circularCanvas.requestPaint()
                analogCanvas.requestPaint()
            }
            Component.onCompleted: resetLevels()
            onBarCountChanged: resetLevels()
            onWidthChanged: repaintAll()
            onHeightChanged: repaintAll()

            // Drive bars from daemon levels (or decay to zero if none)
            Timer {
                interval: 50
                running: true
                repeat: true
                onTriggered: {
                    var n = vuMeter.barCount
                    var levels = []
                    var previous = vuMeter.barHeights
                    var i
                    var target

                    if (root.isPlaying && root.hasDaemonLevels && !root.mediaMode) {
                        var left = root.audioLevels.left || 0
                        var right = root.audioLevels.right || 0
                        var bands = root.audioLevels.bands || []

                        if (n <= 2) {
                            // Stereo / analog: use L/R peaks
                            target = [left, right]
                            for (i = 0; i < n; i++) {
                                var prev = previous[i] || 0
                                var tgt = target[i] !== undefined ? target[i] : 0
                                // Fast attack, slower release
                                levels.push(tgt > prev ? tgt : prev * 0.82 + tgt * 0.18)
                            }
                        } else if (bands.length >= n) {
                            // Real multi-band from daemon
                            for (i = 0; i < n; i++) {
                                var prevB = previous[i] || 0
                                var tgtB = bands[i] || 0
                                levels.push(tgtB > prevB ? tgtB : prevB * 0.82 + tgtB * 0.18)
                            }
                        } else {
                            // Synth bands from L/R until daemon sends bands[]
                            var mid = (left + right) * 0.5
                            for (i = 0; i < n; i++) {
                                var frac = i / Math.max(1, n - 1)
                                // Low bands lean on mid energy, high bands lean on peak
                                var peak = Math.max(left, right)
                                var tgtE = mid * (1 - frac * 0.55) + peak * (frac * 0.7)
                                // Mild shape so it is not a flat line
                                tgtE *= 0.75 + 0.25 * Math.sin(frac * Math.PI)
                                var prevE = previous[i] || 0
                                levels.push(tgtE > prevE ? tgtE : prevE * 0.82 + tgtE * 0.18)
                            }
                        }
                        vuMeter.phase += 0.12 + ((left + right) * 0.5) * 0.25
                    } else {
                        // Stopped, media mode, or no daemon levels yet: decay
                        for (i = 0; i < n; i++)
                            levels.push((previous[i] || 0) * 0.88)
                        if (!root.isPlaying)
                            vuMeter.phase += 0.02
                    }

                    vuMeter.barHeights = levels
                    vuMeter.repaintAll()
                }
            }

            Canvas {
                id: barCanvas
                anchors.fill: parent
                anchors.margins: 4
                visible: ["2-channel Stereo", "10-band EQ", "20-band EQ",
                          "Mirrored EQ", "LED Dots"].indexOf(root.visualizerStyle) >= 0
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    var w = width, h = height
                    if (w < 4 || h < 4) return
                    ctx.fillStyle = "#121412"
                    ctx.fillRect(0, 0, w, h)
                    var n = vuMeter.barCount
                    var gap = 2
                    var style = root.visualizerStyle
                    var vertical = root.visualizerOrientation === "Vertical"

                    // 2-channel: always horizontal, fixed 5px-wide bars, centred
                    if (style === "2-channel Stereo") {
                        var barW = 5
                        var spacing = 24
                        var total = barW * 2 + spacing
                        var x0 = (w - total) / 2
                        for (var i = 0; i < 2; i++) {
                            var lv = vuMeter.barHeights[i] || 0
                            var barH = Math.max(2, h * lv)
                            var x = x0 + i * (barW + spacing)
                            var y = h - barH
                            var g = ctx.createLinearGradient(0, y, 0, h)
                            g.addColorStop(0, "#ff453a")
                            g.addColorStop(0.35, "#f4d03f")
                            g.addColorStop(1, "#32cd58")
                            ctx.fillStyle = g
                            ctx.fillRect(x, y, barW, barH)
                            // L / R labels
                            ctx.fillStyle = "#888888"
                            ctx.font = "9px sans-serif"
                            ctx.textAlign = "center"
                            ctx.fillText(i === 0 ? "L" : "R", x + barW / 2, h - 1)
                        }
                        return
                    }

                    if (style === "LED Dots") {
                        var cols = n
                        var rows = 8
                        var cw = (w - (cols - 1) * gap) / cols
                        var rh = (h - (rows - 1) * gap) / rows
                        for (var c = 0; c < cols; c++) {
                            var lit = Math.round((vuMeter.barHeights[c] || 0) * rows)
                            for (var r = 0; r < rows; r++) {
                                var seg = rows - 1 - r
                                var x = c * (cw + gap)
                                var y = r * (rh + gap)
                                if (seg >= lit) ctx.fillStyle = "#1a1a1a"
                                else if (seg >= 6) ctx.fillStyle = "#ff453a"
                                else if (seg >= 4) ctx.fillStyle = "#f4d03f"
                                else ctx.fillStyle = "#32cd58"
                                ctx.fillRect(x, y, cw, Math.max(1, rh))
                            }
                        }
                        return
                    }

                    if (vertical) {
                        var bh = (h - (n - 1) * gap) / n
                        for (var i2 = 0; i2 < n; i2++) {
                            var level = vuMeter.barHeights[i2] || 0
                            var bw = Math.max(2, w * level)
                            var y2 = i2 * (bh + gap)
                            var grd = ctx.createLinearGradient(0, 0, w, 0)
                            grd.addColorStop(0, "#32cd58")
                            grd.addColorStop(0.65, "#f4d03f")
                            grd.addColorStop(1, "#ff453a")
                            ctx.fillStyle = grd
                            ctx.fillRect(0, y2, bw, bh)
                        }
                    } else if (style === "Mirrored EQ") {
                        var bw2 = (w - (n - 1) * gap) / n
                        for (var j = 0; j < n; j++) {
                            var lv2 = vuMeter.barHeights[j] || 0
                            var barH2 = Math.max(2, h * lv2)
                            var x2 = j * (bw2 + gap)
                            var y3 = (h - barH2) / 2
                            var g2 = ctx.createLinearGradient(0, y3, 0, y3 + barH2)
                            g2.addColorStop(0, "#32cd58")
                            g2.addColorStop(0.6, "#f4d03f")
                            g2.addColorStop(1, "#ff453a")
                            ctx.fillStyle = g2
                            ctx.fillRect(x2, y3, bw2 * 0.9, barH2)
                        }
                    } else {
                        var bw3 = (w - (n - 1) * gap) / n
                        for (var k = 0; k < n; k++) {
                            var lv3 = vuMeter.barHeights[k] || 0
                            var barH3 = Math.max(2, h * lv3)
                            var x3 = k * (bw3 + gap)
                            var y4 = h - barH3
                            var g3 = ctx.createLinearGradient(0, y4, 0, h)
                            g3.addColorStop(0, "#ff453a")
                            g3.addColorStop(0.35, "#f4d03f")
                            g3.addColorStop(1, "#32cd58")
                            ctx.fillStyle = g3
                            ctx.fillRect(x3, y4, bw3 * 0.9, barH3)
                        }
                    }
                }
            }

            Canvas {
                id: waveCanvas
                anchors.fill: parent
                anchors.margins: 4
                visible: root.visualizerStyle === "Waveform"
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    var w = width, h = height
                    if (w < 4 || h < 4) return
                    ctx.fillStyle = "#121412"
                    ctx.fillRect(0, 0, w, h)
                    ctx.strokeStyle = "#32cd58"
                    ctx.lineWidth = 2
                    ctx.beginPath()
                    var n = vuMeter.barCount
                    for (var i = 0; i < n; i++) {
                        var x = (i / Math.max(1, n - 1)) * w
                        var amp = vuMeter.barHeights[i] || 0
                        var y = h / 2 + Math.sin(vuMeter.phase + i * 0.35) * amp * (h * 0.45)
                        if (i === 0) ctx.moveTo(x, y)
                        else ctx.lineTo(x, y)
                    }
                    ctx.stroke()
                }
            }

            Canvas {
                id: circularCanvas
                anchors.fill: parent
                anchors.margins: 4
                visible: root.visualizerStyle === "Circular"
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    var w = width, h = height
                    if (w < 4 || h < 4) return
                    var cx = w / 2, cy = h / 2
                    var base = Math.min(w, h) * 0.22
                    var maxR = Math.min(w, h) * 0.48
                    ctx.fillStyle = "#121412"
                    ctx.fillRect(0, 0, w, h)
                    var n = vuMeter.barCount
                    for (var i = 0; i < n; i++) {
                        var a0 = (i / n) * Math.PI * 2 - Math.PI / 2
                        var a1 = ((i + 0.85) / n) * Math.PI * 2 - Math.PI / 2
                        var level = vuMeter.barHeights[i] || 0
                        var r = base + level * (maxR - base)
                        ctx.beginPath()
                        ctx.arc(cx, cy, r, a0, a1)
                        ctx.arc(cx, cy, base, a1, a0, true)
                        ctx.closePath()
                        if (level > 0.75) ctx.fillStyle = "#ff453a"
                        else if (level > 0.45) ctx.fillStyle = "#f4d03f"
                        else ctx.fillStyle = "#32cd58"
                        ctx.fill()
                    }
                    ctx.beginPath()
                    ctx.arc(cx, cy, base * 0.55, 0, Math.PI * 2)
                    ctx.fillStyle = "#2a2e2a"
                    ctx.fill()
                }
            }

            // Dual stereo analog meters (L + R)
            Canvas {
                id: analogCanvas
                anchors.fill: parent
                anchors.margins: 2
                visible: root.visualizerStyle === "Analog Meter"
                property real needleL: 0
                property real needleR: 0
                onVisibleChanged: if (visible) requestPaint()
                onWidthChanged: requestPaint()
                onHeightChanged: requestPaint()
                onNeedleLChanged: requestPaint()
                onNeedleRChanged: requestPaint()

                Timer {
                    interval: 40
                    running: analogCanvas.visible
                    repeat: true
                    onTriggered: {
                        var tL = vuMeter.barHeights[0] || 0
                        var tR = vuMeter.barHeights[1] || 0
                        analogCanvas.needleL = analogCanvas.needleL * 0.65 + tL * 0.35
                        analogCanvas.needleR = analogCanvas.needleR * 0.65 + tR * 0.35
                    }
                }
                Timer {
                    interval: 40
                    running: analogCanvas.visible && !root.isPlaying
                    repeat: true
                    onTriggered: {
                        analogCanvas.needleL *= 0.85
                        analogCanvas.needleR *= 0.85
                    }
                }

                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    var w = width, h = height
                    if (w < 8 || h < 4) return
                    ctx.fillStyle = "#1a1e1a"
                    ctx.fillRect(0, 0, w, h)

                    function drawMeter(cx, cy, radius, needle, label) {
                        ctx.strokeStyle = "#c8c4a0"
                        ctx.lineWidth = 1.5
                        ctx.beginPath()
                        ctx.arc(cx, cy, radius, Math.PI, 2 * Math.PI)
                        ctx.stroke()
                        for (var i = 0; i <= 20; i++) {
                            var angle = Math.PI + Math.PI * i / 20
                            var inner = radius * (i % 5 === 0 ? 0.72 : (i % 2 === 0 ? 0.80 : 0.86))
                            ctx.beginPath()
                            ctx.moveTo(cx + Math.cos(angle) * inner, cy + Math.sin(angle) * inner)
                            ctx.lineTo(cx + Math.cos(angle) * radius * 0.96,
                                       cy + Math.sin(angle) * radius * 0.96)
                            ctx.strokeStyle = i >= 16 ? "#ff6257" : "#d8d3b0"
                            ctx.lineWidth = i % 5 === 0 ? 1.5 : 0.7
                            ctx.stroke()
                        }
                        ctx.fillStyle = "#d8d3b0"
                        ctx.font = "bold " + Math.max(9, h * 0.12) + "px sans-serif"
                        ctx.textAlign = "center"
                        ctx.fillText(label, cx, cy - radius * 0.35)
                        var nAngle = Math.PI + Math.PI * Math.max(0, Math.min(1, needle))
                        ctx.beginPath()
                        ctx.moveTo(cx, cy)
                        ctx.lineTo(cx + Math.cos(nAngle) * radius * 0.82,
                                   cy + Math.sin(nAngle) * radius * 0.82)
                        ctx.strokeStyle = "#ff4b43"
                        ctx.lineWidth = 2
                        ctx.stroke()
                        ctx.beginPath()
                        ctx.arc(cx, cy, 3.5, 0, Math.PI * 2)
                        ctx.fillStyle = "#d8d3b0"
                        ctx.fill()
                    }

                    var cy = h * 0.92
                    var radius = Math.min(w * 0.22, h * 0.82)
                    var cxL = w * 0.27
                    var cxR = w * 0.73
                    drawMeter(cxL, cy, radius, analogCanvas.needleL, "L")
                    drawMeter(cxR, cy, radius, analogCanvas.needleR, "R")
                }
            }

            PC3.Label {
                anchors.centerIn: parent
                text: root.isPlaying ? "" : "Visualiser idle"
                opacity: 0.4
                visible: !root.isPlaying
                color: "#888888"
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
            }
        }

        // Options
        RowLayout {
            Layout.fillWidth: true
            spacing: 6
            PC3.CheckBox {
                text: "Logging"
                checked: loggingEnabled
                enabled: daemonConnected && !mediaMode
                onToggled: qdbusCall("SetLogging", [checked ? "true" : "false"])
            }
            PC3.CheckBox {
                text: "Notifications"
                checked: pushNotifications
                enabled: daemonConnected && !mediaMode
                onToggled: qdbusCall("SetNotifications", [checked ? "true" : "false"])
            }
            RowLayout {
                visible: !mediaMode
                spacing: 4
                Kirigami.Icon {
                    source: "chronometer"
                    width: PlasmaCore.Units.iconSizes.small
                    height: PlasmaCore.Units.iconSizes.small
                }
                PC3.Slider {
                    id: delaySlider
                    from: 0
                    to: 420
                    value: root.playDelayValue
                    stepSize: 10
                    implicitWidth: 100
                    enabled: daemonConnected
                    onMoved: {
                        root.playDelayValue = value
                        qdbusCall("SetPlayDelay", [value])
                    }
                }
                PC3.Label {
                    text: delaySlider.value + "ms"
                    font.pointSize: Kirigami.Theme.smallestFont.pointSize
                }
            }
            Item { Layout.fillWidth: true }
            PC3.Button {
                text: "Refresh"
                icon.name: "view-refresh"
                visible: !mediaMode
                enabled: daemonConnected
                onClicked: {
                    refreshStations()
                    getState()
                }
            }
            PC3.Button {
                text: "Sign In"
                icon.name: "user-identity"
                visible: !mediaMode
                enabled: daemonConnected
                onClicked: signIn()
            }
        }

        RowLayout {
            Layout.fillWidth: true
            PC3.Label {
                text: mediaMode ? "Media history" : "Recently Played"
                font.bold: true
                Layout.fillWidth: true
            }
            PC3.Label {
                text: "Global Player v3.9"
                font.pointSize: Kirigami.Theme.smallestFont.pointSize
                opacity: 0.6
            }
        }

        ListView {
            Layout.fillWidth: true
            Layout.fillHeight: true
            Layout.minimumHeight: 90
            clip: true
            model: playedSongsModel
            delegate: RowLayout {
                width: ListView.view ? ListView.view.width : 0
                spacing: 6
                PC3.Label {
                    text: model.time || ""
                    opacity: 0.7
                    font.pointSize: Kirigami.Theme.smallestFont.pointSize
                    Layout.preferredWidth: PlasmaCore.Units.gridUnit * 3
                }
                PC3.Label {
                    text: (model.artist || "") + " - " + (model.song || "")
                    Layout.fillWidth: true
                    elide: Text.ElideRight
                    font.pointSize: Kirigami.Theme.smallestFont.pointSize
                }
                PC3.Label {
                    text: model.station || ""
                    color: Kirigami.Theme.positiveTextColor
                    font.pointSize: Kirigami.Theme.smallestFont.pointSize
                    Layout.preferredWidth: PlasmaCore.Units.gridUnit * 5
                    elide: Text.ElideRight
                }
            }
        }
    }
}
